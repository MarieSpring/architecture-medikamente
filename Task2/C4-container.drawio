        <mxCell id="Dyz1j1AdznnOjez-1s9X-41" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Блок комментариев:&lt;/h1&gt;&lt;h2&gt;как данные хранятся&lt;/h2&gt;&lt;div&gt;конфиденциальные данные данные хранятся в зашифроманном виде&lt;/div&gt;&lt;h2&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0.85); font-family: &amp;quot;YS Text&amp;quot;, sans-serif; font-size: 18px; white-space-collapse: preserve-breaks; background-color: rgb(255, 255, 255);&quot;&gt;периоды и условия уничтожения конфиденциальных данных после обработки&lt;/span&gt;&lt;/h2&gt;&lt;div&gt;происходит автоматическое удаление по истечению срока, который определен законодательством&lt;/div&gt;&lt;h2&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255)); color: light-dark(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)); font-family: &amp;quot;YS Text&amp;quot;, sans-serif; font-size: 18px; white-space-collapse: preserve-breaks;&quot;&gt;какие способы защиты данных используются при хранении и передаче данных&lt;/span&gt;&lt;/h2&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255)); color: light-dark(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)); white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;- настроено автоматическое логирование важных действий в системе. логи хранятся в отдельном хранилище с ограничением доступа&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255)); color: light-dark(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)); white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;- настроен мониторинг и алерты на доступ к данным&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255)); color: light-dark(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)); white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;- для контроля доступа используется RBAC&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255)); color: light-dark(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)); white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;- выполняется шифрование данных при хранении и при передаче&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-1860" y="3750" width="830" height="330" as="geometry" />
        </mxCell>
